# DAYFLOW Server Environment
PORT=4000
NODE_ENV=development

# JWT Security
JWT_SECRET=dayflow_hackathon_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=*

# Webhooks
WEBHOOK_SECRET=dayflow_webhook_signing_secret_xyz
WEBHOOK_MAX_RETRIES=3

# Member Integrations (Optional external URLs if services run separately)
MEMBER1_HR_CORE_URL=http://localhost:3001
MEMBER2_AI_ENGINE_URL=http://localhost:3002
