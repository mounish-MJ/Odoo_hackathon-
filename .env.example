# =============================================================
# DAYFLOW — Intelligent HR Operating System Environment Config
# =============================================================

# --- Member 1: HR Core & Backend Settings ---
APP_NAME="HR Core Platform"
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_core_db"

# JWT Security
JWT_SECRET_KEY="development_jwt_secret_key_change_in_production_32bytes_min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Member 2: AI Intelligence & LLM Engine Settings ---
LLM_PROVIDER="mock"
LLM_MODEL="mock-hr-agent"
LLM_API_KEY=""
MAX_TOOL_ITERATIONS=5
MAX_HISTORY_MESSAGES=20

# --- Member 4: Orchestration, Platform, Security & AI Layer ---
# NOTE: Member 4 maintains 100% database isolation with ZERO direct database access.
# All HR data is queried/mutated strictly through Member 1 REST APIs with Authorization: Bearer <JWT>.
PLATFORM_PORT=4000
NODE_ENV=development
JWT_SECRET="dayflow_hackathon_super_secret_jwt_key_2026!"
JWT_EXPIRES_IN="24h"
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN="*"
WEBHOOK_SECRET="dayflow_webhook_signing_secret_xyz"
WEBHOOK_MAX_RETRIES=3

# Inter-Service Communication (Stateless Authenticated HTTP REST)
MEMBER1_HR_CORE_URL="http://localhost:8000"
MEMBER2_AI_ENGINE_URL="http://localhost:8000/api/v1/ai"
