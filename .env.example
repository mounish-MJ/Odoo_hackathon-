# DAYFLOW Member 2 — AI Intelligence & Decision Engine Configuration

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security
JWT_SECRET=dayflow_super_secret_jwt_key_2026_change_in_production

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dayflow_db

# Policy RAG Configuration
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.6
